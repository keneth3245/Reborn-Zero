	{ Class = "MeshPart", Props = { "MeshId", "TextureID" } },
	{ Class = "SpecialMesh", Props = { "MeshId", "TextureId", "MeshType" } },
	{ Class = "Decal", Props = { "Texture" } },
	{ Class = "Model", Props = { "PrimaryPart" } },
	{ Class = "Humanoid", Props = { "MaxHealth", "Health", "WalkSpeed", "JumpPower", "HipHeight", "RigType" }, Volatile = { Health = true } },
	{ Class = "Tool", Props = { "ToolTip", "CanBeDropped", "RequiresHandle" } },
	{ Class = "ProximityPrompt", Props = { "ActionText", "ObjectText", "HoldDuration", "MaxActivationDistance", "RequiresLineOfSight", "Enabled" } },
	{ Class = "ClickDetector", Props = { "MaxActivationDistance" } },
	{ Class = "Sound", Props = { "SoundId", "Volume", "PlaybackSpeed", "Looped", "Playing" }, Volatile = { Playing = true } },
	{ Class = "Animation", Props = { "AnimationId" } },
	{ Class = "ParticleEmitter", Props = { "Texture", "Rate", "Enabled" } },
	{ Class = "Light", Props = { "Brightness", "Range", "Enabled", "Color" } },
	{ Class = "ScreenGui", Props = { "Enabled", "DisplayOrder", "ResetOnSpawn" } },
	{ Class = "GuiObject", Props = { "Visible", "Position", "Size", "AnchorPoint", "BackgroundTransparency" }, Volatile = { Visible = true, Position = true, Size = true, BackgroundTransparency = true } },
	{ Class = "TextLabel", Props = { "Text" }, Volatile = { Text = true } },
	{ Class = "TextButton", Props = { "Text" }, Volatile = { Text = true } },
	{ Class = "TextBox", Props = { "Text" }, Volatile = { Text = true } },
	{ Class = "ImageLabel", Props = { "Image" } },
	{ Class = "ImageButton", Props = { "Image" } },
	{ Class = "ValueBase", Props = { "Value" } },
	{ Class = "BaseScript", Props = { "Disabled" } },
	{ Class = "Script", Props = { "RunContext" } },
	{ Class = "Lighting", Props = { "Brightness", "Ambient", "OutdoorAmbient", "FogStart", "FogEnd", "FogColor", "GlobalShadows", "Technology", "ClockTime" }, Volatile = { ClockTime = true } },
	{ Class = "Workspace", Props = { "Gravity", "StreamingEnabled", "FallenPartsDestroyHeight" } },
}

local ASSET_PROPS = { SoundId = true, AnimationId = true, MeshId = true, TextureID = true, TextureId = true, Texture = true, Image = true }

-- Hard guarantee: script source is never read, whatever gets added to the specs.
local FORBIDDEN_PROPS = { Source = true }

local specCache = {}
local function specsFor(inst, className)
	local cached = specCache[className]
	if cached then return cached end
	local list = {}
	for _, spec in ipairs(PROPERTY_SPECS) do
		local ok, isA = pcall(callIsA, inst, spec.Class)
		if ok and isA then list[#list + 1] = spec end
	end
	specCache[className] = list
	return list
end

local classFlagCache = {}
local function classFlags(inst, className)
	local f = classFlagCache[className]
	if f then return f end
	local function isA(c)
		local ok, r = pcall(callIsA, inst, c)
		return ok and r == true
	end
	f = { part = isA("BasePart"), gui = isA("GuiObject"), value = isA("ValueBase"), sound = isA("Sound"), anim = isA("Animation") }
	classFlagCache[className] = f
	return f
end

local function buildProps(inst, className, structuralOnly)
	if not CONFIG.RecordProperties then return nil, nil, nil end
	local specs = specsFor(inst, className)
	if #specs == 0 then return nil, nil, nil end

	local props, hashProps, assets
	for _, spec in ipairs(specs) do
		local volatile = spec.Volatile
		for _, propName in ipairs(spec.Props) do
			if not FORBIDDEN_PROPS[propName] and not (propName == "Text" and not CONFIG.RecordTextProperties) then
				local ok, raw = pcall(index, inst, propName)
				if ok and raw ~= nil then
					local value = serializeValue(raw)
					if value ~= nil then
						props = props or {}
						props[propName] = value
						if not structuralOnly and not (volatile and volatile[propName]) then
							hashProps = hashProps or {}
							hashProps[propName] = value
						end
						if ASSET_PROPS[propName] and type(value) == "string" and value ~= "" then
							assets = assets or {}
							assets[#assets + 1] = { propName, value }
						end
					end
				end
			end
		end
	end

	-- Unanchored parts move: their transform must not influence the fingerprint.
	if hashProps and props and props.Anchored == false then
		hashProps.Position = nil
		hashProps.Orientation = nil
	end
	return props, hashProps, assets
end

----------------------------------------------------------------------
-- FILE OUTPUT
----------------------------------------------------------------------
local function ensureFolder(path)
	if not HAS.isfolder or not HAS.makefolder then return false end
	local ok, exists = pcall(isfolder, path)
	if ok and exists then return true end
	pcall(makefolder, path)
	local ok2, now = pcall(isfolder, path)
	return ok2 and now == true
end

local function newStream(path)
	local stream = { path = path, buffer = {}, held = {}, lines = 0, bytes = 0, ok = true, err = nil }
	if HAS.writefile then
		local ok, err = pcall(writefile, path, "")
		if not ok then stream.ok, stream.err = false, tostring(err) end
	else
		stream.ok, stream.err = false, "writefile unavailable"
	end

	local function flush()
		if #stream.buffer == 0 then return end
		local chunk = table.concat(stream.buffer, "\n") .. "\n"
		stream.buffer = {}
		if not stream.ok then return end
		if HAS.appendfile then
			local ok, err = pcall(appendfile, stream.path, chunk)
			if not ok then stream.ok, stream.err = false, tostring(err) end
		else
			stream.held[#stream.held + 1] = chunk
		end
	end

	function stream.add(line)
		stream.buffer[#stream.buffer + 1] = line
		stream.lines += 1
		stream.bytes += #line + 1
		if #stream.buffer >= 1000 then flush() end
	end

	function stream.close()
		flush()
		if stream.ok and not HAS.appendfile then
			local ok, err = pcall(writefile, stream.path, table.concat(stream.held))
			if not ok then stream.ok, stream.err = false, tostring(err) end
			stream.held = {}
		end
		return stream.ok, stream.err
	end

	return stream
end

