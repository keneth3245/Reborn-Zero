----------------------------------------------------------------------
-- SMALL HELPERS (no per-call closures in hot paths)
----------------------------------------------------------------------
local function yieldNow()
	if task and task.wait then
		task.wait()
	else
		wait()
	end
end

local function index(obj, key) return obj[key] end
local function callGetChildren(i) return i:GetChildren() end
local function callGetAttributes(i) return i:GetAttributes() end
local function callGetTags(i) return i:GetTags() end
local function callGetFullName(i) return i:GetFullName() end
local function callIsA(i, className) return i:IsA(className) end
local function callGetPivot(i) return i:GetPivot() end

local function round3(n)
	if n ~= n then return "NaN" end
	if n == math.huge then return "Infinity" end
	if n == -math.huge then return "-Infinity" end
	return math.floor(n * 1000 + 0.5) / 1000
end

local function cleanString(s)
	s = tostring(s)
	if utf8 and utf8.len and not utf8.len(s) then
		s = string.gsub(s, "[\128-\255]", "?")
	end
	return (string.gsub(s, "%c", " "))
end

local function truncate(s, maxLen)
	s = tostring(s)
	if #s > maxLen then s = string.sub(s, 1, maxLen) end
	return cleanString(s)
end

local function safeFullName(inst)
	local ok, r = pcall(callGetFullName, inst)
	if ok then return cleanString(r) end
	return cleanString(inst.Name)
end

local function sortedKeys(t)
	local keys = {}
	for k in pairs(t) do keys[#keys + 1] = k end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
	return keys
end

local function joinKeys(t, limit)
	local keys = sortedKeys(t)
	local out = {}
	for i = 1, math.min(#keys, limit) do out[i] = tostring(keys[i]) end
	local text = table.concat(out, ",")
	if #keys > limit then text ..= ",+" .. (#keys - limit) end
	return text
end

-- Stable FNV-1a (32 bit). h*16777619 is split so it never exceeds 2^53.
local function fnv1a(s)
	local h = 2166136261
	for i = 1, #s do
		h = bit32.bxor(h, string.byte(s, i))
		h = (bit32.lshift(h, 24) + h * 403) % 4294967296
	end
	return string.format("%08x", h)
end

-- Deterministic string form of a (serialized) value, independent of pairs() order.
local function canon(value)
	if type(value) == "table" then
		local keys = sortedKeys(value)
		local parts = table.create(#keys)
		for i, k in ipairs(keys) do
			parts[i] = tostring(k) .. "=" .. canon(value[k])
		end
		return "{" .. table.concat(parts, ",") .. "}"
	end
	return tostring(value)
end

----------------------------------------------------------------------
-- JSON SAFETY NET (only used if a plain encode fails)
----------------------------------------------------------------------
local function sanitizeForJSON(value, depth, seen)
	depth = depth or 0
	seen = seen or {}
	local t = type(value)
	if t == "number" then
		if value ~= value or value == math.huge or value == -math.huge then return tostring(value) end
		return value
	elseif t == "string" then
		return cleanString(value)
	elseif t == "boolean" then
		return value
	elseif t == "table" then
		if depth > 40 then return "<depth-limit>" end
		if seen[value] then return "<recursive>" end
		seen[value] = true
		local out = {}
		local isArray, n = true, 0
		for k in pairs(value) do
			n += 1
			if type(k) ~= "number" then isArray = false end
		end
		if isArray and n == #value then
			for i = 1, n do
				local v = sanitizeForJSON(value[i], depth + 1, seen)
				out[i] = v == nil and "<nil>" or v
			end
		else
			for k, v in pairs(value) do
				local sv = sanitizeForJSON(v, depth + 1, seen)
				out[cleanString(k)] = sv == nil and "<nil>" or sv
			end
		end
		seen[value] = nil
		return out
	elseif t == "nil" then
		return nil
	end
	return cleanString(tostring(value))
end

local function encodeJSON(data)
	local ok, result = pcall(HttpService.JSONEncode, HttpService, data)
	if ok then return result, nil end
	local ok2, result2 = pcall(HttpService.JSONEncode, HttpService, sanitizeForJSON(data))
	if ok2 then return result2, nil end
	return nil, tostring(result2)
end

----------------------------------------------------------------------
-- VALUE SERIALIZATION (compact + rounded so diffs stay stable)
--   Vector3 -> [x,y,z]   Color3 -> "#rrggbb"   Enum -> "Name"   Instance -> "@path"
----------------------------------------------------------------------
local function toHex(c)
	local function ch(v) return math.clamp(math.floor(v * 255 + 0.5), 0, 255) end
	return string.format("#%02x%02x%02x", ch(c.R), ch(c.G), ch(c.B))
end

local function serializeValue(value)
	local t = typeof(value)
	if t == "number" then
		return round3(value)
	elseif t == "string" then
		return truncate(value, 300)
	elseif t == "boolean" then
		return value
	elseif t == "Vector3" then
		return { round3(value.X), round3(value.Y), round3(value.Z) }
	elseif t == "Vector2" then
		return { round3(value.X), round3(value.Y) }
	elseif t == "Color3" then
		return toHex(value)
	elseif t == "CFrame" then
		local rx, ry, rz = value:ToOrientation()
		return {
			p = { round3(value.X), round3(value.Y), round3(value.Z) },
			r = { round3(math.deg(rx)), round3(math.deg(ry)), round3(math.deg(rz)) },
		}
	elseif t == "UDim2" then
		return { round3(value.X.Scale), value.X.Offset, round3(value.Y.Scale), value.Y.Offset }
	elseif t == "UDim" then
		return { round3(value.Scale), value.Offset }
	elseif t == "NumberRange" then
		return { round3(value.Min), round3(value.Max) }
	elseif t == "BrickColor" or t == "EnumItem" then
		return value.Name
	elseif t == "Instance" then
		return "@" .. safeFullName(value)
	elseif t == "nil" then
		return nil
	end
	return truncate(tostring(value), 200)
end

