-- Volatile = recorded, but excluded from the change fingerprint.
----------------------------------------------------------------------
local PROPERTY_SPECS = {
	{ Class = "BasePart", Props = { "Position", "Orientation", "Size", "Anchored", "CanCollide", "CanTouch", "CanQuery", "Transparency", "Material", "Color", "Massless", "CollisionGroup" } },
